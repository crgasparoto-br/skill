# Example ONLY. The actual EnvironmentFile must be root-owned 0600.
# Never copy this file as-is into a live systemd service.
# These values must be independently verified on the VPS.
#
# Controller must be a dedicated OAuth-verifying service UID:
# NOT root (0), github-auth (997), or rootless worker (1004).
SOLVERIT_BROKER_CONTROLLER_UID=REPLACE_WITH_TRUSTED_CONTROLLER_UID
# Numeric GID of a local group containing only controller and github-auth.
SOLVERIT_BROKER_SOCKET_GID=REPLACE_WITH_BROKER_GROUP_GID
# Keycloak issuer, pinned JWKS, and exact MCP audience.
SOLVERIT_OAUTH_ISSUER_URL=https://auth.example.invalid/realms/solverit-delivery
SOLVERIT_OAUTH_JWKS_URI=https://auth.example.invalid/realms/solverit-delivery/protocol/openid-connect/certs
SOLVERIT_MCP_RESOURCE_URL=https://mcp.example.invalid/mcp
# Explicitly approved OIDC sub values; no usernames from MCP tool arguments.
SOLVERIT_MCP_DELIVERY_SUBJECTS=REPLACE_WITH_ALLOWLISTED_OIDC_SUBJECT
# No GitHub token, PEM, OAuth client secret or JWT is allowed in this file.
