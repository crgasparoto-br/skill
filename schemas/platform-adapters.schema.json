{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crgasparoto-br/skill/blob/main/schemas/platform-adapters.schema.json",
  "title": "Skill platform adapters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system", "catalog_version", "adapters"],
  "properties": {
    "schema_version": {"const": 1},
    "system": {"const": "skill-platform-adapters"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"},
    "adapters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/adapter"}}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "status", "introduced_in", "instruction_path", "capability_source", "capability_profile", "provided_capabilities", "fallback_policy", "prohibited_assumptions", "load_order"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "platform": {"type": "string", "minLength": 3},
        "status": {"enum": ["planned", "implemented", "validated"]},
        "introduced_in": {"$ref": "#/$defs/semver"},
        "instruction_path": {"type": "string", "pattern": "^adapters/[a-z0-9_.-]+\\.(md|yaml)$"},
        "capability_source": {"const": "host-declared"},
        "capability_profile": {"const": "none-assumed"},
        "provided_capabilities": {"const": []},
        "fallback_policy": {"const": "config/capabilities.json"},
        "prohibited_assumptions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "load_order": {
          "type": "array",
          "prefixItems": [
            {"const": "config/compatibility.json"},
            {"const": "config/skills-catalog.json"},
            {"const": "config/capabilities.json"},
            {"const": "config/platform-adapters.json"},
            {"const": "<skill>/SKILL.md"},
            {"const": "conditional references"},
            {"const": "schemas/contracts/scripts"}
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      }
    }
  }
}
