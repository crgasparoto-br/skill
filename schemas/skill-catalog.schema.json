{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crgasparoto-br/skill/blob/main/schemas/skill-catalog.schema.json",
  "title": "Skill catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system", "catalog_version", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "system": {"const": "skill-catalog"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "path", "status", "purpose", "summary", "input", "modes",
        "read_only", "write_owner", "contract_version", "positive_triggers",
        "negative_triggers", "required_capabilities"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "path": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "status": {"enum": ["planned", "implemented", "validated"]},
        "purpose": {"type": "string", "minLength": 2},
        "summary": {"type": "string", "minLength": 10, "maxLength": 300},
        "input": {"type": "string", "minLength": 3, "maxLength": 200},
        "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "read_only": {"type": "boolean"},
        "write_owner": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"},
        "positive_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "negative_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
      }
    }
  }
}
