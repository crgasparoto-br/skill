{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crgasparoto-br/skill/blob/main/evals/schemas/eval-manifest.schema.json",
  "title": "Behavioral evaluation harness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system", "harness_version", "status", "runner", "validator", "case_schema", "result_schema", "report_schema"],
  "properties": {
    "schema_version": {"const": 1},
    "system": {"const": "behavioral-evaluation-harness"},
    "harness_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["planned", "implemented", "validated"]},
    "runner": {"const": "evals/run_evals.py"},
    "validator": {"const": "scripts/validate_evals.py"},
    "case_schema": {"const": "evals/schemas/eval-case.schema.json"},
    "result_schema": {"const": "evals/schemas/eval-result.schema.json"},
    "report_schema": {"const": "evals/schemas/eval-report.schema.json"}
  }
}
