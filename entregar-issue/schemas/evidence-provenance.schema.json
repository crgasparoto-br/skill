{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery evidence provenance",
  "type": "object",
  "required": [
    "schema_version",
    "material_head_sha",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "material_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "path",
          "sha256",
          "subject_sha",
          "freshness_policy",
          "producer",
          "status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "behavioral",
              "structural",
              "quantitative",
              "documentation"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "subject_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40,64}$"
          },
          "base_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F]{40,64}$"
          },
          "freshness_policy": {
            "enum": [
              "exact-material-head",
              "reusable"
            ]
          },
          "producer": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "const": "passed"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
